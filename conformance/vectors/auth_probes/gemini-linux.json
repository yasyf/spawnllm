{
  "name": "gemini-linux",
  "op": "auth_probes",
  "input": {
    "provider": "gemini",
    "host": {
      "platform": "linux",
      "home": "/home/testuser"
    }
  },
  "expected": {
    "binary": "gemini",
    "install_hint": "npm install -g @google/gemini-cli",
    "probes": [
      {
        "kind": "file_exists",
        "path": "/home/testuser/.gemini/oauth_creds.json"
      },
      {
        "kind": "env_any",
        "vars": [
          "GEMINI_API_KEY",
          "GOOGLE_API_KEY"
        ]
      }
    ]
  }
}
