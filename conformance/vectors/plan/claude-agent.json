{
  "name": "claude-agent",
  "op": "plan",
  "input": {
    "provider": "claude",
    "spec": {
      "prompt": "hi",
      "model": "opus",
      "agent": true,
      "isolated": true,
      "timeout": 180,
      "max_attempts": 5,
      "api_auth": false,
      "schema": null,
      "claude": null,
      "codex": null,
      "gemini": null,
      "openai_endpoint": null
    },
    "host": {
      "platform": "darwin"
    }
  },
  "expected": {
    "kind": "exec",
    "argv": [
      "claude",
      "-p",
      "--no-session-persistence",
      "--model",
      "opus",
      "--setting-sources",
      "",
      "--strict-mcp-config",
      "--permission-mode",
      "auto",
      "--max-budget-usd",
      "1"
    ],
    "stdin": "hi",
    "files": [
      {
        "id": "stdout",
        "suffix": ".json",
        "content": null
      }
    ],
    "stdout_to_file": true,
    "read_result_from": "stdout",
    "env": {
      "CLAUDE_CONFIG_DIR": "${isolated_config_dir}"
    },
    "env_unset": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN"
    ],
    "needs_claude_isolation": true
  }
}
