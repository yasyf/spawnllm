{
  "name": "claude-settings",
  "op": "plan",
  "input": {
    "provider": "claude",
    "spec": {
      "prompt": "hi",
      "model": "haiku",
      "agent": false,
      "isolated": true,
      "timeout": 180,
      "max_attempts": 5,
      "api_auth": false,
      "schema": null,
      "apple": null,
      "claude": {
        "append_system_prompt": null,
        "disable_slash_commands": false,
        "disallowed_tools": [],
        "max_budget_usd": null,
        "max_turns": null,
        "mcp_config": null,
        "output_format": null,
        "permission_mode": null,
        "setting_sources": null,
        "settings": "{\"model\":\"opus\"}",
        "strict_mcp": false,
        "system_prompt": null,
        "tools": null,
        "verbose": false
      },
      "codex": null,
      "gemini": null,
      "openai_endpoint": null
    },
    "host": {
      "platform": "darwin"
    }
  },
  "expected": {
    "kind": "exec",
    "argv": [
      "claude",
      "-p",
      "--no-session-persistence",
      "--model",
      "haiku",
      "--setting-sources",
      "",
      "--strict-mcp-config",
      "--settings",
      "{\"model\":\"opus\"}"
    ],
    "stdin": "hi",
    "files": [
      {
        "id": "stdout",
        "suffix": ".json",
        "content": null
      }
    ],
    "stdout_to_file": true,
    "read_result_from": "stdout",
    "env": {
      "CHOKIDAR_INTERVAL": "300000",
      "CHOKIDAR_USEPOLLING": "1",
      "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
      "CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES": "1",
      "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
      "CLAUDE_CODE_DISABLE_FILE_CHECKPOINTING": "1",
      "CLAUDE_CODE_GB_DISK_CACHE_WHEN_TELEMETRY_OFF": "1",
      "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
      "CLAUDE_CODE_PLUGIN_DIR_WATCH": "false",
      "CLAUDE_CONFIG_DIR": "${isolated_config_dir}",
      "DISABLE_AUTOUPDATER": "1",
      "DISABLE_ERROR_REPORTING": "1",
      "DISABLE_INSTALLATION_CHECKS": "1",
      "DISABLE_TELEMETRY": "1",
      "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
    },
    "env_unset": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN"
    ],
    "needs_claude_isolation": true
  }
}
