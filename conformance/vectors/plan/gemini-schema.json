{
  "name": "gemini-schema",
  "op": "plan",
  "input": {
    "provider": "gemini",
    "spec": {
      "prompt": "hi",
      "model": "gemini-2.5-flash",
      "agent": false,
      "isolated": true,
      "timeout": 180,
      "max_attempts": 5,
      "api_auth": false,
      "schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ]
      },
      "apple": null,
      "claude": null,
      "codex": null,
      "gemini": null,
      "openai_endpoint": null
    },
    "host": {
      "platform": "darwin"
    }
  },
  "expected": {
    "kind": "exec",
    "argv": [
      "gemini",
      "--model",
      "gemini-2.5-flash",
      "-o",
      "json",
      "--approval-mode",
      "default",
      "-e",
      "none",
      "-p",
      "hi\n\nRespond with ONLY a single JSON object that conforms to this JSON Schema. No prose, no explanation, no markdown code fences.\nJSON Schema:\n{\"type\": \"object\", \"properties\": {\"answer\": {\"type\": \"string\"}}, \"required\": [\"answer\"]}"
    ],
    "stdin": "",
    "files": [],
    "stdout_to_file": false,
    "read_result_from": "stdout",
    "env": {},
    "env_unset": [
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY"
    ],
    "needs_claude_isolation": false
  }
}
